<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- Ambient Glow Background -->
    <View
        android:id="@+id/glow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/splash_glow" />

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="8dp"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_payments" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="PoolSanj"
            android:textColor="#dde3ee"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="سیستم جامع مدیریت مالی"
            android:textColor="#C6C6CC"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Loading Dots -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="100dp"
        android:alpha="0"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp"
            android:layout_marginHorizontal="3dp" android:background="@drawable/dot" />
        <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp"
            android:layout_marginHorizontal="3dp" android:background="@drawable/dot" />
        <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp"
            android:layout_marginHorizontal="3dp" android:background="@drawable/dot" />
    </LinearLayout>
</FrameLayout>
