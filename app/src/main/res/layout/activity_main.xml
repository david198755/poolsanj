<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <!-- TopAppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#CC1A2028"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_nav_currency"
            app:tint="#F7BE36" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="PoolSanj"
            android:textColor="#DDE3EE"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="آخرین بروزرسانی"
            android:textColor="#C6C6CC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Custom Bottom Nav - matches Stitch exactly -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#CC1A2028"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp"
        android:paddingTop="4dp">

        <!-- مبدل -->
        <LinearLayout
            android:id="@+id/nav_conv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item">
            <ImageView
                android:id="@+id/icon_conv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_converter" />
            <TextView
                android:id="@+id/text_conv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مبدل"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- بازار (active) -->
        <LinearLayout
            android:id="@+id/nav_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item_active">
            <ImageView
                android:id="@+id/icon_summary"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_market" />
            <TextView
                android:id="@+id/text_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بازار"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ارز -->
        <LinearLayout
            android:id="@+id/nav_arz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item">
            <ImageView
                android:id="@+id/icon_arz"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_currency" />
            <TextView
                android:id="@+id/text_arz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ارز"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- طلا -->
        <LinearLayout
            android:id="@+id/nav_tala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item">
            <ImageView
                android:id="@+id/icon_tala"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_gold" />
            <TextView
                android:id="@+id/text_tala"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلا"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- کریپتو -->
        <LinearLayout
            android:id="@+id/nav_crypto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item">
            <ImageView
                android:id="@+id/icon_crypto"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_crypto" />
            <TextView
                android:id="@+id/text_crypto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کریپتو"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
